+#ifdef __linux__
+/* Fast path for the single most common wait shape in real applications:
+ * waiting on exactly one mutex (RtlEnterCriticalSection falling into its
+ * blocking path, or a plain WaitForSingleObject(hMutex, ...)). Uses a futex
+ * directly on `tid` instead of going through poll()/eventfd, so acquiring
+ * and releasing an *uncontended* mutex now costs zero syscalls each,
+ * instead of one apiece (a read() on grab, a write() on release).
+ *
+ * Deliberately scoped to non-alertable single-handle waits only: supporting
+ * alertable waits here would mean also multiplexing the APC fd, which needs
+ * poll() anyway and defeats the point. Those still fall through to the
+ * regular poll()-based path below, which is unaffected by any of this. */
+static NTSTATUS esync_wait_mutex_fast( struct esync *obj, HANDLE handle, const LARGE_INTEGER *timeout )
+{
+    struct mutex *mutex = obj->shm;
+    DWORD tid = GetCurrentThreadId();
+    ULONGLONG end = 0;
+
+    if (mutex->tid == tid)
+    {
+        TRACE("Woken up by handle %p [0] (recursive).\n", handle);
+        mutex->count++;
+        return STATUS_SUCCESS;
+    }
+
+    if (timeout)
+    {
+        LARGE_INTEGER now;
+        NtQuerySystemTime( &now );
+        end = (timeout->QuadPart >= 0) ? timeout->QuadPart : now.QuadPart - timeout->QuadPart;
+    }
+
+    InterlockedIncrement( &mutex->waiters );
+
+    for (;;)
+    {
+        LONG owner = InterlockedCompareExchange( &mutex->tid, tid, 0 );
+
+        if (!owner)
+        {
+            InterlockedDecrement( &mutex->waiters );
+            mutex->count = 1;
+            TRACE("Woken up by handle %p [0].\n", handle);
+            return STATUS_SUCCESS;
+        }
+
+        if (owner == ~0)
+        {
+            /* Abandoned. Still try to grab it -- CAS from the abandoned
+             * sentinel specifically, so we don't clobber a legitimate new
+             * owner if we lost a race for it. */
+            if (InterlockedCompareExchange( &mutex->tid, tid, ~0 ) == ~0)
+            {
+                InterlockedDecrement( &mutex->waiters );
+                mutex->count = 1;
+                TRACE("Woken up by abandoned mutex %p [0].\n", handle);
+                return STATUS_ABANDONED_WAIT_0;
+            }
+            continue;
+        }
+
+        if (timeout)
+        {
+            struct timespec tmo;
+            LONGLONG timeleft = update_timeout( end );
+
+            if (!timeleft)
+            {
+                InterlockedDecrement( &mutex->waiters );
+                TRACE("Wait timed out.\n");
+                return STATUS_TIMEOUT;
+            }
+            tmo.tv_sec  = timeleft / (ULONGLONG)TICKSPERSEC;
+            tmo.tv_nsec = (timeleft % TICKSPERSEC) * 100;
+
+            if (futex_wait( &mutex->tid, owner, &tmo ) == -1 && errno == ETIMEDOUT)
+            {
+                InterlockedDecrement( &mutex->waiters );
+                TRACE("Wait timed out.\n");
+                return STATUS_TIMEOUT;
+            }
+        }
+        else
+        {
+            futex_wait( &mutex->tid, owner, NULL );
+        }
+
+        /* EAGAIN (value already changed under us), EINTR, or a genuine
+         * wakeup: loop around and re-check from scratch either way. */
+    }
+}
+#endif
