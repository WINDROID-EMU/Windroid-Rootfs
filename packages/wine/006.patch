+/* Wrapper around do_poll() that marks any mutex objects among the polled
+ * set as having a waiter for the duration of the call, so that
+ * esync_release_mutex() knows it must not skip waking this thread (see the
+ * comment there). `objs`/`objs_count` describe which sync objects are
+ * actually being polled on right now via `fds` -- for the wait-any path
+ * that's the whole set; for the wait-all path, which polls one object at a
+ * time, it's just that one object. Unconditional (not under #ifdef
+ * __linux__): it only touches the `waiters` counter, it doesn't need
+ * futex(2) itself, so it's harmless -- if the counter is never checked by
+ * anything on a hypothetical non-Linux build, this is just a couple of
+ * extra InterlockedIncrement/Decrement calls. */
+static int do_poll_mutex_aware( struct esync *const *objs, unsigned int objs_count,
+                                 struct pollfd *fds, nfds_t nfds, ULONGLONG *end )
+{
+    unsigned int i;
+    int ret;
+
+    for (i = 0; i < objs_count; i++)
+        if (objs[i] && objs[i]->type == ESYNC_MUTEX)
+            InterlockedIncrement( &((struct mutex *)objs[i]->shm)->waiters );
+
+    ret = do_poll( fds, nfds, end );
+
+    for (i = 0; i < objs_count; i++)
+        if (objs[i] && objs[i]->type == ESYNC_MUTEX)
+            InterlockedDecrement( &((struct mutex *)objs[i]->shm)->waiters );
+
+    return ret;
