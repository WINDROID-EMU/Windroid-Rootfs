+static HRESULT WINAPI d3dx9_line_DrawTransform(ID3DXLine *iface, const D3DXVECTOR3 *vertex_list,
+        DWORD vertex_list_count, const D3DXMATRIX *transform, D3DCOLOR color)
+{
+    struct d3dx9_line *line = impl_from_ID3DXLine(iface);
+    D3DXVECTOR3 *transformed_vertices = NULL;
+    HRESULT hr;
+    DWORD i;
+
+    TRACE("iface %p, vertex_list %p, vertex_list_count %lu, transform %p, color 0x%08lx.\n",
+            iface, vertex_list, vertex_list_count, transform, color);
+
+    if (!vertex_list || vertex_list_count < 2)
+        return D3DERR_INVALIDCALL;
+
+    if (!line->state)
+        return D3DERR_INVALIDCALL;
+
+    /* Apply transform if provided */
+    if (transform)
+    {
+        transformed_vertices = malloc(vertex_list_count * sizeof(*transformed_vertices));
+        if (!transformed_vertices)
+            return E_OUTOFMEMORY;
+
+        for (i = 0; i < vertex_list_count; i++)
+        {
+            D3DXVec3TransformCoord(&transformed_vertices[i], &vertex_list[i], transform);
+        }
+        vertex_list = transformed_vertices;
+    }
+
+    /* Set vertex color */
+    hr = IDirect3DDevice9_SetFVF(line->device, D3DFVF_XYZ | D3DFVF_DIFFUSE);
+    if (FAILED(hr))
+        goto cleanup;
+
+    /* Draw line strip */
+    hr = IDirect3DDevice9_SetRenderState(line->device, D3DRS_TEXTUREFACTOR, color);
+    if (FAILED(hr))
+        goto cleanup;
+
+    hr = IDirect3DDevice9_DrawPrimitiveUP(line->device, D3DPT_LINESTRIP, vertex_list_count - 1,
+            vertex_list, sizeof(*vertex_list));
+
+cleanup:
+    free(transformed_vertices);
+    return hr;
+}
