 DWORD WINAPI D3DXCpuOptimizations(BOOL enable)
 {
-    FIXME("%#x - stub\n", enable);
+    TRACE("%#x\n", enable);
+    
+    /* Return supported CPU optimizations flags
+     * D3DX_CPU_OPTIMIZATION flags are not well documented,
+     * but we can return basic SIMD support flags */
+    if (enable)
+    {
+        /* Enable CPU optimizations - return supported features */
+        DWORD flags = 0;
+        
+        /* Check for SSE support */
+#ifdef __SSE__
+        flags |= 0x1; /* D3DX_CPU_OPTIMIZATION_SSE */
+#endif
+        
+#ifdef __SSE2__
+        flags |= 0x2; /* D3DX_CPU_OPTIMIZATION_SSE2 */
+#endif
+        
+        return flags;
+    }
+    
+    /* Disable optimizations */
     return 0;
 }
