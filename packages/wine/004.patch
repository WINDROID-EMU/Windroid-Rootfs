+            left = (x > 0) ? src_data[idx - 1] : src_data[idx];
+            right = (x < desc.Width - 1) ? src_data[idx + 1] : src_data[idx];
+            up = (y > 0) ? src_data[idx - (src_locked.Pitch / sizeof(float))] : src_data[idx];
