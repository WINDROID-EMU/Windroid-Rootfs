+static short scale_value(unsigned short input)
+{
+    return -32768 + ((input * 65535) / 255);
+}
+
+static void read_virtual_controller_state(struct provider *impl)
+{
+    WSADATA wsaData;
+    SOCKET clientSocket;
+    struct sockaddr_in serverAddr;
+    struct timeval timeout;
+    const char *env = getenv("MICEWINE_JOYSTICK_SERVER_IP");
+    const char *serverIp = env ? env : "127.0.0.1";
+    char buffer[BUFFER_SIZE];
+    int serverAddrSize = sizeof(serverAddr);
+    int res = -1;
+
+    static BOOL wsa_initialized = FALSE;
+    if (!wsa_initialized)
+    {
+        if (WSAStartup(MAKEWORD(2, 2), &wsaData) != 0)
+        {
+            ERR( "Failed to initialize Winsock\n" );
+            return;
+        }
+        wsa_initialized = TRUE;
+    }
+
+    clientSocket = socket(AF_INET, SOCK_DGRAM, 0);
+    if (clientSocket == INVALID_SOCKET)
+    {
+        ERR( "Error creating socket: %d\n", WSAGetLastError() );
+        return;
+    }
+
+    serverAddr.sin_family = AF_INET;
+    serverAddr.sin_addr.s_addr = inet_addr(serverIp);
+    serverAddr.sin_port = htons(SERVER_PORT);
+
+    timeout.tv_sec = 0;
+    timeout.tv_usec = 100000; // 100ms timeout
+
+    if (setsockopt(clientSocket, SOL_SOCKET, SO_RCVTIMEO, (const char*)&timeout, sizeof(timeout)) < 0)
+    {
+        WARN( "Failed to set socket timeout\n" );
+    }
+
+    memset(buffer, 0, BUFFER_SIZE);
+    res = recvfrom(clientSocket, buffer, BUFFER_SIZE, 0, (struct sockaddr*)&serverAddr, &serverAddrSize);
+
+    if (res > 0 && buffer[0] == REQUEST_GET_CONTROLLER_STATE)
+    {
+        /*
+            Buffer Scheme:
+            buffer[0]: Type of operation
+            buffer[1]: Controller Connected Status
+            buffer[2]: A, B, X, Y, RB, LB, RS, LS Button State
+            buffer[3]: Start, Select Button State
+            buffer[4]: D-Pad Status
+            buffer[5]: Left X Analog Status (0-255)
+            buffer[6]: Left Y Analog Status (0-255)
+            buffer[7]: Right X Analog Status (0-255)
+            buffer[8]: Right Y Analog Status (0-255)
+            buffer[9]: LT Status (0-255)
+            buffer[10]: RT Status (0-255)
+        */
+
+        memset(&impl->virtual_state, 0, sizeof(impl->virtual_state));
+
+        impl->virtual_state.buttons[0] = (buffer[2] & A_BUTTON) != 0;
+        impl->virtual_state.buttons[1] = (buffer[2] & B_BUTTON) != 0;
+        impl->virtual_state.buttons[2] = (buffer[2] & X_BUTTON) != 0;
+        impl->virtual_state.buttons[3] = (buffer[2] & Y_BUTTON) != 0;
+        impl->virtual_state.buttons[4] = (buffer[2] & LB_BUTTON) != 0;
+        impl->virtual_state.buttons[5] = (buffer[2] & RB_BUTTON) != 0;
+        impl->virtual_state.buttons[6] = (buffer[2] & LS_BUTTON) != 0;
+        impl->virtual_state.buttons[7] = (buffer[2] & RS_BUTTON) != 0;
+        impl->virtual_state.buttons[8] = (buffer[3] & SELECT_BUTTON) != 0;
+        impl->virtual_state.buttons[9] = (buffer[3] & START_BUTTON) != 0;
+
+        /* D-Pad to switches */
+        switch (buffer[4])
+        {
+            case 0: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Center; break;
+            case 1: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Up; break;
+            case 2: impl->virtual_state.switches[0] = GameControllerSwitchPosition_UpRight; break;
+            case 3: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Right; break;
+            case 4: impl->virtual_state.switches[0] = GameControllerSwitchPosition_DownRight; break;
+            case 5: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Down; break;
+            case 6: impl->virtual_state.switches[0] = GameControllerSwitchPosition_DownLeft; break;
+            case 7: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Left; break;
+            case 8: impl->virtual_state.switches[0] = GameControllerSwitchPosition_Left; break; /* LeftUp não existe, usar Left */
+        }
+
+        /* Analog axes */
+        impl->virtual_state.axes[0] = scale_value(buffer[5]) / 65535.;
+        impl->virtual_state.axes[1] = scale_value(buffer[6]) / 65535.;
+        impl->virtual_state.axes[2] = scale_value(buffer[7]) / 65535.;
+        impl->virtual_state.axes[3] = scale_value(buffer[8]) / 65535.;
+        impl->virtual_state.axes[4] = buffer[9] / 255.;
+        impl->virtual_state.axes[5] = buffer[10] / 255.;
+
+        impl->virtual_state.timestamp = GetTickCount64();
+    }
+
+    closesocket(clientSocket);
+}
