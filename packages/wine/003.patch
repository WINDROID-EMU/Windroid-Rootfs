+
+void provider_create_virtual( void )
+{
+    static const WCHAR virtual_device_path[] = L"MICEWINE_VIRTUAL_CONTROLLER";
+    IGameControllerProvider *provider;
+    struct provider *impl, *entry;
+    BOOL found = FALSE;
+
+    TRACE( "Creating virtual MiceWine controller provider\n" );
+
+    EnterCriticalSection( &provider_cs );
+    LIST_FOR_EACH_ENTRY( entry, &provider_list, struct provider, entry )
+        if ((found = !wcsicmp( entry->device_path, virtual_device_path ))) break;
+    LeaveCriticalSection( &provider_cs );
+
+    if (found)
+    {
+        TRACE( "Virtual provider already exists\n" );
+        return;
+    }
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        ERR( "Failed to allocate virtual provider\n" );
+        return;
+    }
+
+    impl->IWineGameControllerProvider_iface.lpVtbl = &wine_provider_vtbl;
+    impl->IGameControllerProvider_iface.lpVtbl = &game_provider_vtbl;
+    impl->dinput_device = NULL;
+    impl->device = NULL;
+    impl->preparsed = NULL;
+    impl->report_buf = NULL;
+    wcscpy( impl->device_path, virtual_device_path );
+    impl->ref = 1;
+    impl->is_virtual = TRUE;
+
+    provider = &impl->IGameControllerProvider_iface;
+    list_add_tail( &provider_list, &impl->entry );
+    manager_on_provider_created( provider );
+    TRACE( "Virtual provider created successfully\n" );
+}
